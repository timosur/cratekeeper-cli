#!/usr/bin/env bash
# Thin wrapper — runs the crate CLI from the repo .venv without activation.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VENV="$SCRIPT_DIR/.venv"

if [ ! -x "$VENV/bin/crate" ]; then
    echo "ERROR: .venv not found. Run 'make venv' first." >&2
    exit 1
fi

exec "$VENV/bin/crate" "$@"
